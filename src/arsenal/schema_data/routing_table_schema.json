{
  "$id": "https://github.com/bitbytelabio/arsenal/schemas/routing-table.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "meta",
    "categories",
    "priority",
    "routes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "meta": {
      "type": "object",
      "required": [
        "domain",
        "description"
      ],
      "properties": {
        "domain": {
          "enum": [
            "re",
            "webapp",
            "mobile",
            "red"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "fallbackId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priority": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][0-9]+$"
      }
    },
    "routes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "leaf",
          "category",
          "must"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][0-9]+$"
          },
          "leaf": {
            "type": "string",
            "pattern": "^(re|webapp|mobile|red)-[a-z0-9-]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "must": {
            "type": "string",
            "minLength": 1
          },
          "mustAll": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclude": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "crossDomain": {
            "type": "object",
            "required": [
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
