{
  "$id": "https://github.com/bitbytelabio/arsenal/schemas/specialist-handoff.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "sec-re",
        "sec-webapp",
        "sec-mobile",
        "sec-red",
        "sec-verifier"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "maxLength": 150
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "cwe": {
            "type": "string",
            "pattern": "^CWE-[0-9]+$"
          },
          "evidenceReceipts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "epistemicStatus": {
            "type": "string",
            "enum": [
              "E",
              "P"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "severity",
          "location",
          "cwe",
          "evidenceReceipts",
          "epistemicStatus"
        ],
        "additionalProperties": false
      }
    },
    "coverageJudgement": {
      "type": "string",
      "enum": [
        "covered",
        "partial",
        "uncovered"
      ]
    },
    "unresolvedVariables": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^unk-.*$"
      }
    },
    "capabilityGap": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "taskId",
    "role",
    "findings",
    "coverageJudgement",
    "unresolvedVariables",
    "capabilityGap"
  ],
  "additionalProperties": false
}
