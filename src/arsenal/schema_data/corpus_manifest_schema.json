{
  "$id": "https://github.com/bitbytelabio/arsenal/schemas/corpus-manifest.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "generator",
    "created_at",
    "summary",
    "sources",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "null"
    },
    "summary": {
      "type": "object",
      "required": [
        "total_considered",
        "admitted",
        "quarantined",
        "excluded",
        "deduplicated"
      ],
      "properties": {
        "total_considered": {
          "type": "integer",
          "minimum": 0
        },
        "admitted": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "deduplicated": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "repo",
          "rev",
          "license"
        ],
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "rev": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-.]+(\\+|( (AND|OR|WITH) [a-zA-Z0-9-.]+))*$"
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "patternProperties": {
        "^arsenal-local$": {
          "type": "object",
          "required": [
            "repo",
            "rev",
            "license"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "rev": {
              "type": "null"
            },
            "license": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9-.]+(\\+|( (AND|OR|WITH) [a-zA-Z0-9-.]+))*$"
            }
          },
          "additionalProperties": false
        },
        "^(?!arsenal-local$).*": {
          "type": "object",
          "required": [
            "repo",
            "rev",
            "license"
          ],
          "properties": {
            "repo": {
              "type": "string",
              "minLength": 1
            },
            "rev": {
              "type": "string",
              "pattern": "^[0-9a-f]{7,64}$"
            },
            "license": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9-.]+(\\+|( (AND|OR|WITH) [a-zA-Z0-9-.]+))*$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "source",
          "source_rev",
          "license",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_rev": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-.]+(\\+|( (AND|OR|WITH) [a-zA-Z0-9-.]+))*$"
          },
          "status": {
            "enum": [
              "admitted",
              "deduplicated",
              "quarantined",
              "excluded"
            ]
          },
          "reason": {
            "type": "string"
          },
          "destination_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "superseded_by": {
            "type": "string"
          },
          "source_path": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "support_files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "source_path",
                "sha256",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "source_path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "deduplicated"
                }
              }
            },
            "then": {
              "required": [
                "superseded_by",
                "reason"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "destination_path"
                    ]
                  },
                  {
                    "required": [
                      "sha256"
                    ]
                  },
                  {
                    "required": [
                      "bytes"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "quarantined",
                    "excluded"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "admitted"
                }
              }
            },
            "then": {
              "required": [
                "destination_path",
                "sha256",
                "bytes"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "arsenal-local"
                }
              }
            },
            "then": {
              "properties": {
                "source_rev": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "source_rev": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{7,64}$"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "dedup_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "tier",
          "members",
          "rationale",
          "applied"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "A",
              "B"
            ]
          },
          "members": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "winner": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "applied": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "tier": {
                  "const": "A"
                }
              }
            },
            "then": {
              "required": [
                "winner"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "support_files": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path",
            "source_path",
            "sha256",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "source_path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
