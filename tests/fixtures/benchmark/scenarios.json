  {
    "id": "BENCH-010",
    "title": "Local File Inclusion via Export Template Parameter",
    "domain": "red",
    "category": "path_traversal",
    "groundTruth": "vulnerable",
    "context": {
      "endpoint": "/admin/export",
      "parameter": "template"
    },
    "expectedFinding": {
      "cwe": "CWE-98",
      "severity": "high"
    },
    "oracleCheck": {
      "oracle_type": "path_traversal",
      "parameters": {
        "baselineStatusCode": 404,
        "baselineBody": "Default Template",
        "probeResponses": [
          { "depth": 1, "statusCode": 404, "body": "Default Template" },
          { "depth": 3, "statusCode": 200, "body": "root:x:0:0:root:/root:/bin/bash\nmail:x:8:8:mail:/var/mail:/usr/sbin/nologin" }
        ]
