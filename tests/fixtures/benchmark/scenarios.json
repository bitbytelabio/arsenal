    "domain": "webapp",
    "category": "sqli_timing",
    "groundTruth": "benign",
    "context": {
      "endpoint": "/api/v1/analytics/report",
      "parameter": "query",
      "payload": "complex query without injection"
    },
    "oracleCheck": {
      "oracle_type": "timing_differential",
      "parameters": {
        "expectedDelayMs": 5000,
        "pairs": [
          { "baselineMs": 350, "probeMs": 420 },
          { "baselineMs": 400, "probeMs": 390 },
          { "baselineMs": 380, "probeMs": 410 },
          { "baselineMs": 360, "probeMs": 395 }
        ]
      }
    }
  },
  {
    "id": "BENCH-003",
    "title": "Broken Object Level Authorization (BOLA/IDOR) on User Profile",
    "domain": "webapp",
    "category": "authz",
    "groundTruth": "vulnerable",
    "context": {
      "endpoint": "/api/v1/users/42/profile",
      "method": "GET"
    },
    "expectedFinding": {
      "cwe": "CWE-639",
      "severity": "high"
    },
    "oracleCheck": {
      "oracle_type": "authz_matrix",
      "parameters": {
        "endpoint": "/api/v1/users/42/profile",
        "observations": [
          { "role": "authorized", "statusCode": 200, "isBusinessDataPresent": true, "body": "{\"id\":42,\"email\":\"victim@target.com\"}" },
          { "role": "unauthorized", "statusCode": 200, "isBusinessDataPresent": true, "body": "{\"id\":42,\"email\":\"victim@target.com\"}" },
          { "role": "anonymous", "statusCode": 401, "isBusinessDataPresent": false, "body": "{\"error\":\"unauthorized\"}" }
        ]
      }
    }
  },
  {
    "id": "BENCH-004",
    "title": "Properly Enforced Role-Based Access Control on Administrative Settings (Negative Control)",
    "domain": "webapp",
    "category": "authz",
    "groundTruth": "benign",
    "context": {
      "endpoint": "/api/v1/admin/settings",
      "method": "GET"
    },
    "oracleCheck": {
      "oracle_type": "authz_matrix",
      "parameters": {
        "endpoint": "/api/v1/admin/settings",
        "observations": [
          { "role": "authorized", "statusCode": 200, "isBusinessDataPresent": true, "body": "{\"settings\":{\"mfa\":true}}" },
          { "role": "unauthorized", "statusCode": 403, "isBusinessDataPresent": false, "body": "{\"error\":\"Forbidden\"}" },
          { "role": "anonymous", "statusCode": 401, "isBusinessDataPresent": false, "body": "{\"error\":\"Unauthorized\"}" }
        ]
      }
    }
  },
  {
    "id": "BENCH-005",
    "title": "Path Traversal Arbitrary File Read in Document Viewer",
    "domain": "webapp",
    "category": "path_traversal",
    "groundTruth": "vulnerable",
    "context": {
      "endpoint": "/download",
      "parameter": "filename",
      "payload": "../../../../etc/passwd"
    },
    "expectedFinding": {
      "cwe": "CWE-22",
      "severity": "high"
    },
    "oracleCheck": {
      "oracle_type": "path_traversal",
      "parameters": {
        "baselineStatusCode": 404,
        "baselineBody": "File not found",
        "probeResponses": [
          { "depth": 1, "statusCode": 404, "body": "File not found" },
          { "depth": 2, "statusCode": 404, "body": "File not found" },
          { "depth": 4, "statusCode": 200, "body": "root:x:0:0:root:/root:/bin/bash\ndaemon:x:1:1:daemon:/usr/sbin:/usr/sbin/nologin" }
        ]
      }
    }
  },
  {
    "id": "BENCH-006",
