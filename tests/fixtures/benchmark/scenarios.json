[
  {
    "id": "BENCH-001",
    "title": "Time-based Blind SQL Injection on Authentication Endpoint",
    "domain": "webapp",
    "category": "sqli_timing",
    "groundTruth": "vulnerable",
    "context": {
      "endpoint": "/api/v1/auth/login",
      "parameter": "username",
      "payload": "' OR (SELECT SLEEP(5))=0 --"
    },
    "expectedFinding": {
      "cwe": "CWE-89",
      "severity": "critical"
    },
    "oracleCheck": {
      "oracle_type": "timing_differential",
      "parameters": {
        "expectedDelayMs": 5000,
        "pairs": [
          { "baselineMs": 95, "probeMs": 5120 },
          { "baselineMs": 102, "probeMs": 5090 },
          { "baselineMs": 98, "probeMs": 5110 },
          { "baselineMs": 105, "probeMs": 5085 }
        ]
      }
    }
  },
  {
    "id": "BENCH-002",
