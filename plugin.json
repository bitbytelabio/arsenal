{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "arsenal",
  "version": "3.0.2",
  "description": "Arsenal Security Engagement Harness Plugin for Oh My Pi",
  "author": {
    "name": "arsenal"
  },
  "license": "MIT",
  "capabilities": {
    "roles": [
      "master",
      "sec-re",
      "sec-webapp",
      "sec-mobile",
      "sec-red",
      "sec-verifier"
    ],
    "routers": [
      "arsenal-re-router",
      "arsenal-webapp-router",
      "arsenal-mobile-router",
      "arsenal-red-router"
    ],
    "extensions": [
      "bounding",
      "budget",
      "routing"
    ],
    "tools": [
      "skill_search",
      "skill_route",
      "skill_list",
      "skill_load",
      "skill_asset_load"
