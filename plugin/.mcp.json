{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "ida-pro": {
      "type": "stdio",
      "enabled": false,
      "command": "uvx",
      "args": [
        "ida-pro-mcp"
      ]
    },
    "ghidra": {
      "type": "stdio",
      "enabled": false,
      "command": "uv",
      "args": [
        "run",
        "-m",
        "ghidra_mcp"
      ]
    },
    "jshook": {
      "type": "stdio",
      "enabled": false,
      "command": "node",
      "args": [
        "jshookmcp.js"
      ]
    },
    "burp-ultra": {
      "type": "sse",
      "enabled": false,
      "url": "${BURP_MCP_URL:-http://127.0.0.1:9876/}",
      "headers": {
        "Authorization": "Bearer ${BURP_MCP_TOKEN}"
      }
    },
    "playwright": {
      "type": "stdio",
      "enabled": false,
      "command": "bunx",
      "args": [
        "@playwright/mcp@latest"
      ]
    },
    "rea": {
      "type": "stdio",
      "enabled": false,
      "command": "bunx",
      "args": [
        "rea-agents@6.4.0",
        "mcp"
      ]
    }
  }
}