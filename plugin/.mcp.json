{
  "mcpServers": {
    "ida-pro": {
      "transport": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "ida_mcp"
      ],
      "enabled": false
    },
    "ghidra": {
      "transport": "stdio",
      "command": "python3",
      "args": [
        "-m",
        "ghidra_mcp"
      ],
      "enabled": false
    },
    "frida": {
      "transport": "stdio",
      "command": "frida-mcp",
      "enabled": false
    },
    "jshook": {
      "transport": "stdio",
      "command": "jshookmcp",
      "enabled": false
    },
    "burp-ultra": {
      "transport": "sse",
      "url": "http://127.0.0.1:8080/mcp",
      "enabled": false
    }
  }
}