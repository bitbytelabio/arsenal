      "category": "forensics",
      "must": "disk.*image|autopsy|filesystem.*forensic|file.*recovery|dd\\b.*image",
      "note": "Disk image acquisition and filesystem artifact analysis"
    },
    "R8": {
      "id": "R8",
      "leaf": "re-auditing-uefi-firmware-with-chipsec",
      "category": "firmware",
      "must": "firmware|uefi|chipsec|bios|bootkit",
      "note": "Firmware and UEFI security auditing"
