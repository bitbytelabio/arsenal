{
  "schemaVersion": "1.1",
  "meta": {
    "domain": "re",
    "description": "Reverse engineering domain routing table for binary analysis, decompilation, exploitation, forensics, firmware, and cryptography."
  },
  "categories": [
    "binary-analysis",
    "cryptography",
    "decompilation",
    "exploitation",
    "firmware",
