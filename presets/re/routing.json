  "routes": {
    "R1": {
      "id": "R1",
      "leaf": "re-ida-reverse",
      "category": "decompilation",
      "must": "\\bida\\b|\\bidalib\\b|idapro|idb|decompile.*ida",
      "note": "IDA Pro disassembly and decompilation triage"
    },
    "R2": {
      "id": "R2",
      "leaf": "re-ghidra-reverse",
      "category": "decompilation",
      "must": "ghidra|headless.*ghidra|pyghidra",
      "note": "Ghidra open-source reverse engineering and decompilation"
    },
    "R3": {
      "id": "R3",
      "leaf": "re-radare2",
      "category": "binary-analysis",
      "must": "radare2|\\br2\\b|r2pipe|rabin2",
      "note": "radare2 command-line binary analysis and triage"
    },
    "R4": {
      "id": "R4",
      "leaf": "re-patch-diff-exploit",
      "category": "binary-analysis",
      "must": "patch.*diff|bindiff|n-day.*patch|diff.*exploit",
      "note": "Binary patch differential analysis for 1-day/n-day vulnerabilities"
    },
    "R5": {
      "id": "R5",
      "leaf": "re-pwn-chain",
      "category": "exploitation",
