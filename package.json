{
  "name": "arsenal",
  "version": "3.0.0",
  "description": "Arsenal Security Harness",
  "type": "module",
  "bin": { "arsenal": "./bin/arsenal.ts" },
  "scripts": {
    "build": "bun run bin/arsenal.ts build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "upstream:check": "bun --no-env-file run tools/sync-upstreams.ts --check",
    "upstream:update": "bun --no-env-file run tools/sync-upstreams.ts --write"
  },
  "dependencies": { "ajv": "^8.17.1", "ajv-formats": "^3.0.1", "yaml": "^2.7.0" },
  "devDependencies": { "@types/bun": "latest", "@types/node": "^22.13.9", "typescript": "^5.8.2" }
}
